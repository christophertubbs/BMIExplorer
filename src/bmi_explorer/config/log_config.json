{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"plain": {"format": "%(name)s: %(levelname)s: %(message)s"}},
  "handlers": {"stderr": {"class": "logging.StreamHandler", "formatter": "plain", "stream": "ext://sys.stderr"}},
  "loggers": {"bmi_explorer": {"level": "WARNING", "handlers": ["stderr"], "propagate": false}}
}
